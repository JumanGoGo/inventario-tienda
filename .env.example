# Base de datos
POSTGRES_USER=inventario_user
POSTGRES_PASSWORD=inventario_pass
POSTGRES_DB=inventario_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Construida a partir de las variables anteriores (usada por la app)
DATABASE_URL=postgresql://inventario_user:inventario_pass@db:5432/inventario_db

# App
APP_NAME=Sistema de Gestion de Inventario
APP_ENV=development
